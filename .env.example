# ─── 용도 1) 로컬 터널 (scripts/tunnel.sh) ───
# cp .env.example .env  →  아래 두 줄만 채우면 된다. 나머지는 EC2 배포용.
# Firebase Console → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성 → JSON 저장
#
#   FIREBASE_PROJECT_ID=your-project-id
#   FIREBASE_CREDENTIALS_PATH=/absolute/path/to/serviceAccountKey.json
#
# 아래 SPRING_PROFILES_ACTIVE=prod 는 터널 실행에 영향을 주지 않는다
# (tunnel.sh 가 --spring.profiles.active=local-tunnel 을 명령행으로 넘기고,
#  Spring 은 명령행 인자를 환경변수보다 우선한다)
# 자세한 내용: TUNNEL.md

# ─── 용도 2) EC2 서버에 .env 파일로 복사해서 사용 ───
# cp .env.example .env  →  실제 값으로 채우기
# .env 파일은 절대 git에 커밋하지 않음

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Database (AWS RDS)
DB_URL=jdbc:mysql://<RDS_ENDPOINT>:3306/tagupdb?useSSL=true&characterEncoding=UTF-8
DB_USERNAME=tagup
DB_PASSWORD=your-db-password

# Firebase Admin SDK
# Firebase Console → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성 → JSON 파일
# cat firebase-service-account.json | base64 | tr -d '\n'  →  아래 값으로 사용
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS=base64-encoded-service-account-json
# 로컬 터널에서는 base64 대신 JSON 파일 경로를 써도 된다
# FIREBASE_CREDENTIALS_PATH=/absolute/path/to/serviceAccountKey.json

# AWS S3 (이미지 업로드용, Sprint 3)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=tagup-images
AWS_REGION=ap-northeast-2
